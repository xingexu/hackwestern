{
  "name": "western-campus-drive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm run setup:python",
    "setup:python": "python3 -m venv .venv && .venv/bin/python -m pip install -r build/requirements.txt",
    "dev": "vite --host 127.0.0.1",
    "build": "node build/race_build.mjs",
    "prestart": "npm run build",
    "start": "node server/lan.mjs",
    "verify": "agentkit verify full",
    "dev:online": "wrangler dev --local --config server/wrangler.jsonc --var MULTIPLAYER:1",
    "deploy": "npm run build && wrangler deploy --config server/wrangler.jsonc"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "three": "0.170.0",
    "three-mesh-bvh": "0.8.3"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
