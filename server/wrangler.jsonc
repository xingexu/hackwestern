{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "drive-western",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [],
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist/app",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {"MULTIPLAYER":"1"},
  "durable_objects": {
    "bindings": [
      {"name": "RACES", "class_name": "Arena"},
      {"name": "ROOMS", "class_name": "Room"},
      {"name": "LEADERS", "class_name": "Leaderboard"}
    ]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["Room","Leaderboard"]},{"tag":"v2","new_sqlite_classes":["Arena"]}],
  "env": {
    "domain": {
      "name": "drive-western",
      "workers_dev": true,
      "routes": [{"pattern":"fwestern.ca","custom_domain":true},{"pattern":"www.fwestern.ca","custom_domain":true}],
      "vars": {"MULTIPLAYER":"1"},
      "durable_objects": {
        "bindings": [
          {"name": "RACES", "class_name": "Arena"},
          {"name": "ROOMS", "class_name": "Room"},
          {"name": "LEADERS", "class_name": "Leaderboard"}
        ]
      }
    }
  },
  "dev": {"ip":"127.0.0.1","port":8787}
}
