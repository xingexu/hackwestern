  "evidence": [
    {
      "kind": "knowledge",
      "note": "Address points 548 and 550 each record a three-storey, 12-unit apartment building on this joined footprint.",
      "url": "https://maps.london.ca/server/rest/services/BASEMAP_ORTHO_UTM/MapServer/0"
    },
    {
      "kind": "knowledge",
      "note": "Western identifies its 1976 three-storey apartment walk-ups and shows a balcony on the unit plans.",
      "url": "https://apartments.uwo.ca/prospective-tenants/buildings/platts-lane"
    },
    {
      "kind": "kartaview",
      "note": "Two levels of balconies above patios. Brown opaque railing panels alternate with open metal pickets. Pale concrete slabs project beyond the masonry. Narrow stair windows break up the recessed areas. Brown masonry averages RGB 86,72,69 in the shaded (249,111)–(268,130) patch of a 460 × 385 copy. Wall colour is lifted for daylight.",
      "frame": "46920587",
      "walls": [
        2,
        4,
        6
      ]
    },
    {
      "kind": "kartaview",
      "note": "The west elevation has three levels, lower patio doors, a darker recessed access and shallow gabled roof sections.",
      "frame": "46920586",
      "walls": [
        4,
        6
      ]
    },
    {
      "kind": "kartaview",
      "note": "A close oblique shows cantilevered slabs, masonry patio screens, brown painted railing and separate ground-level glazed openings.",
      "frame": "46920588",
      "walls": [
        2,
        3
      ]
    },
    {
      "kind": "aerial",
      "note": "Two broad shingle roof sections alternate with narrower links and ends. Walks and parking courts run along both long sides."
    },
    {
      "kind": "lidar",
      "note": "Regional 2 m lidar above local ground measures 10.01 m at P50, 10.93 m at P90 and 13.36 m at maximum. Across the broad roof the 2 m samples rise from about 9 m to 11.2 m and fall toward the opposite eave."
    },
    {
      "kind": "lidar",
      "note": "Along both long walls the roof-to-ground break falls west of the inventory polygon. The four apartment sections and their stair link have been moved together 3.4 m west and 0.2 m north."
    },
    {
      "kind": "kartaview",
      "note": "Frame 46920587 shows patio doors beneath the west balcony stacks and short masonry dividers. The corresponding east patios and the east stair approach are inferred."
    }
  ],
  "notes": "Railings alternate opaque brown panels and open pickets on the same slab. Short masonry patio screens, individual patio doors and projecting balcony slabs are distinct from the stair entrances. East-side balconies and stair door positions are inferred from symmetry and the paths. Ground-floor patio doors sit beside the living-room windows beneath the balcony stacks. Their mirrored positions on the east side are inferred.",
