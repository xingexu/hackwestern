{
  "schema": "western-building-spec/1",
  "id": "w310130110",
  "name": "Clare Hall and Mercato Dining Pavilion",
  "status": "refined",
  "confidence": 0.89,
  "summary": "Four- and five-storey residence wings combine pale fieldstone-faced bays with grey metal panels. Facing the lawn, the lower Mercato pavilion presents a tall glass wall beneath a shallow folded roof.",
  "style": "contemporary-stone",
  "evidence": [
    {
      "kind": "knowledge",
      "url": "https://tvsef.ca/wp-content/uploads/2023/03/brescia_map-TVSEF.pdf",
      "note": "Resident entrance is on the south drop-off. Mercato occupies the lower northeast block."
    },
    {
      "kind": "photo",
      "url": "https://www.uwo.ca/fm/img/what_we_do/bldg/CH.jpg",
      "note": "Main entry at base of a tall rectangular panelled bay, pale grey metal window and spandrel strips and brown-grey irregular masonry piers. Colours sampled from photograph."
    },
    {
      "kind": "photo",
      "url": "https://www.haymanconstruction.com/Educational.htm",
      "note": "Contractor photographs from the old residence show room bays, a metal-clad end and a separate glazed dining pavilion with a folded eave. Contractor confirms four- and five-floor wings."
    },
    {
      "kind": "kartaview",
      "frame": "146585439",
      "walls": [
        19,
        20
      ],
      "note": "A small portion of the dining pavilion glazing is visible at the left of Ursuline Hall, across the lawn. Residence wings are screened."
    },
    {
      "kind": "aerial",
      "note": "City of London 2025 orthophoto. White membrane roofs, staggered projections facing the court, square plant room near the northwest bend, lower dining volume to east and vehicle drop-off along wall 22."
    },
    {
      "kind": "lidar",
      "note": "Inventory P50 15.03 m, P90 19.44 m, maximum 26.23 m. Dining roof roughly 7–8 m, long residential ranges around 15–17 m and northern wing near 19–20 m. Highest local returns cluster at mechanical equipment."
    },
    {
      "kind": "aerial",
      "note": "Clare Hall sets its southwest bay and recessed glass entry behind the lay-by paving, while its eastern service wing extends further toward the drive."
    }
  ],
