  "evidence": [
    {
      "kind": "aerial",
      "note": "The small square roof at the north entrance lies between the west and cross wings. The centre link is long and narrow. The south roofs step up around laboratory plant."
    },
    {
      "kind": "lidar",
      "note": "Regional 2 m surface relative to local ground. Median 15.7 m, 90th percentile 21.23 m, maximum 27.93 m."
    },
    {
      "kind": "photo",
      "url": "https://commons.wikimedia.org/wiki/File:SEB_Front_Tower.jpg",
      "note": "The entrance has an open traceried belfry, battlements, arch, paired corner shafts and two rows of multi-light stone windows to the west."
    },
    {
      "kind": "photo",
      "url": "https://www.uwo.ca/fm/img/what_we_do/bldg/SEB.jpg",
      "note": "Axial approach to the tower and the east wing."
    },
    {
      "kind": "kartaview",
      "frame": "146585525",
      "walls": [
        41,
        42,
        43
      ],
      "note": "Trees obscure most of the north elevation from the road."
    },
    {
      "kind": "kartaview",
      "frame": "67820751",
      "walls": [
        23,
        24
      ],
      "note": "The prominent ribbed stone facade belongs to the adjoining pavilion. It obscures this return."
    },
    {
      "kind": "knowledge",
      "note": "Main wall colour sampled with PIL from Wikimedia tower photograph. 511 × 520 pixel reference, patch centred at (184, 231), 7 × 7 pixels."
    },
    {
      "kind": "lidar",
      "walls": [
        0,
        1,
        41,
        42,
        43,
        45
      ],
      "note": "Ground along the original northwest wing sits 5.0–6.0 m above the inventory datum. The lower floor is buried from Lambton Drive; two rows face the approach."
    },
    {
      "kind": "kartaview",
      "note": "The camera is west and south of wall 17. Cream sawtooth fins and a darker base fill its right edge.",
      "frame": "138539175",
      "walls": [
        17,
        18
      ]
    },
    {
      "kind": "lidar",
      "note": "First returns cross the belfry at z 618–625. The central raised laboratory roof reaches 21–22 m above datum and the narrow service strip immediately east of it measures 16 m. The eastern auditorium aisle is about one metre below the main roof. The door at the paved link notch is inferred from the path terminus."
    },
    {
      "kind": "lidar",
      "note": "The tower corner shoulders are square and finish close to the 27–28 m belfry parapet. The isolated higher return aligns with the flagpole."
    }
  ],
