    {
      "kind": "photo",
      "url": "https://london.ca/sites/default/files/2021-04/2019%20Abstracts.pdf",
      "note": "The project retained an outside north passage to the tunnel laboratory."
    },
    {
      "kind": "knowledge",
      "note": "The pre-Chakma university oblique shows pale cladding. Available pixels mix facade and roof at this scale. The current material is uncertain."
    },
    {
      "kind": "lidar",
      "note": "At z 784–792 the first returns at x 57 and 59 fall to roughly 1 m, between Chakma and the 7–8 m tunnel roof beginning near x 61."
    },
    {
      "kind": "lidar",
      "note": "The south roof continues through z 834 at x 78 and 79. The roof in the shared court steps around an open strip with near-ground first returns around x 62–67, z 757–762."
    }
