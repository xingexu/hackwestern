  "evidence": [
    {
      "kind": "knowledge",
      "note": "Community Living London identifies the Ford Crescent service at 25 Ford Crescent.",
      "url": "https://community-living-london.squarespace.com/snoezelen"
    },
    {
      "kind": "knowledge",
      "note": "The Ford Access map pin at 42.9972579, −81.2786699 falls within this footprint south of the school.",
      "url": "https://www.waze.com/live-map/directions/ca/on/london/community-living-london-%28ford-access%29?to=place.ChIJXaHRTyfuLogRqoI03LmyvbA"
    },
    {
      "kind": "aerial",
      "note": "The drive reaches the stepped north elevation. A pale entrance cover adjoins the middle strip. Two low flat wings have weathered gravel surfaces, small roof curbs and vents. Roof finish sampled from the orthophoto."
    },
    {
      "kind": "lidar",
      "note": "Regional 2 m lidar above local ground measures 3.31 m at P50, 4.35 m at P90 and 11.90 m at maximum. Sampling inside each wing gives 3.2–3.4 m; the centre is about 4.3 m. The 11.9 m returns coincide with a tree at the south roof edge."
    },
    {
      "kind": "knowledge",
      "note": "No unobstructed ground-level image was found. Masonry material and colour, regular window spacing and entry geometry are low-confidence approximations."
    },
    {
      "kind": "photo",
      "url": "https://static1.squarespace.com/static/63b45568c214431261cecb1a/t/6abbeeae5c25e81bb47c69c1/1790701230858/Annual%2BReport%2B2025-2026%2Bfor%2Bwebsite.pdf#page=18",
      "note": "The Ford Access backyard photograph shows a wooden perimeter screen. It does not resolve the building elevations."
    },
    {
      "kind": "lidar",
      "note": "Median interior metre-grid elevations above survey ground are 3.22 and 3.24 m for the wings, 3.85 m for the north centre and 4.26 m for the south centre."
    },
    {
      "kind": "lidar",
      "note": "Lidar returns continue approximately two metres beyond the mapped west wall. The roof perimeter is shifted 2.3 m west and 0.8 m north. The central roof breaks and equipment were traced in orthophoto coordinates."
    },
    {
      "kind": "aerial",
      "note": "The wings have pale weathered roof surfaces with darker patches. The north perimeter has staggered oblique returns."
    }
  ],
  "notes": "The roof survey resolves two central planes and three open pale edge curbs. Door positions at the curbs and the window spacing are inferred. The organization’s photograph of the backyard shows a timber screen and leaves the wall finish obscured.",
